# Copy this file to .env.sync and fill in your values.
# .env.sync is in .gitignore and will never be committed.
# Run from a machine on the NHS network: node scripts/sync-confluence.js

CONFLUENCE_BASE_URL=https://nhsd-confluence.digital.nhs.uk
CONFLUENCE_EMAIL=your.email@nhs.net
CONFLUENCE_API_TOKEN=your_api_token_here

OPENAI_API_KEY=sk-...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
